--- !u!114 &812359538
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 812359537}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dddcc38c3012aa742992aa0c24486542, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  techs:
  - id: agriculture
    title: "\u0417\u0435\u043C\u043B\u0435\u0434\u0435\u043B\u0438\u0435"
    description: "\u0410\u043C\u0431\u0430\u0440: +1 \U0001F34E \u0441 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u0441\u0438\u043C\u0432\u043E\u043B\u0430 \u0435\u0434\u044B"
    branch: 0
    knowledgeCost: 5
    requires: []
  - id: pottery
    title: "\u0413\u043E\u043D\u0447\u0430\u0440\u043D\u043E\u0435 \u0434\u0435\u043B\u043E"
    description: "\u041A\u043B\u0430\u0434\u043E\u0432\u044B\u0435 \u0432 \u0430\u043C\u0431\u0430\u0440\u0435:
      \u0440\u043E\u0441\u0442 \u0433\u043E\u0440\u043E\u0434\u0430 \u043D\u0430
      25% \u0434\u0435\u0448\u0435\u0432\u043B\u0435"
    branch: 0
    knowledgeCost: 9
    requires:
    - agriculture
  - id: trade
    title: "\u0422\u043E\u0440\u0433\u043E\u0432\u043B\u044F"
    description: "\u0422\u043E\u0440\u0433\u043E\u0432\u044B\u0435 \u0440\u044F\u0434\u044B
      \u043D\u0430 \u0431\u0430\u0437\u0430\u0440\u0435: +1 \U0001FA99 \u0441 \u043A\u0430\u0436\u0434\u043E\u0439
      \u043C\u043E\u043D\u0435\u0442\u044B"
    branch: 0
    knowledgeCost: 12
    requires:
    - pottery
  - id: crafts
    title: "\u0420\u0435\u043C\u0451\u0441\u043B\u0430"
    description: "\u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F: +1
      \u2692 \u0441 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0441\u0438\u043C\u0432\u043E\u043B\u0430
      \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430"
    branch: 0
    knowledgeCost: 5
    requires: []
  - id: masonry
    title: "\u041A\u0430\u043C\u0435\u043D\u043D\u0430\u044F \u043A\u043B\u0430\u0434\u043A\u0430"
    description: "\u0427\u0430\u0441\u0442\u043E\u043A\u043E\u043B \u0443 \u0440\u0430\u0442\u0443\u0448\u0438:
      \u043D\u0430\u0431\u0435\u0433\u0438 \u043D\u0430\u043D\u043E\u0441\u044F\u0442
      \u043D\u0430 40% \u043C\u0435\u043D\u044C\u0448\u0435 \u0443\u0440\u043E\u043D\u0430"
    branch: 0
    knowledgeCost: 8
    requires:
    - crafts
  - id: writing
    title: "\u041F\u0438\u0441\u044C\u043C\u0435\u043D\u043D\u043E\u0441\u0442\u044C"
    description: "\u0428\u043A\u043E\u043B\u0430: +50% \u043E\u0447\u043A\u043E\u0432
      \u0437\u043D\u0430\u043D\u0438\u0439 \U0001F4D6"
    branch: 1
    knowledgeCost: 5
    requires: []
  - id: mathematics
    title: "\u041C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430"
    description: "\u0423\u0447\u0451\u0442 \u0432 \u0440\u0430\u0442\u0443\u0448\u0435:
      +6 \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u0432 \u043D\u0430 \u043F\u043E\u043B\u0435
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C"
    branch: 1
    knowledgeCost: 9
    requires:
    - writing
  - id: philosophy
    title: "\u0424\u0438\u043B\u043E\u0441\u043E\u0444\u0438\u044F"
    description: "\u0411\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430 \u0432
      \u0448\u043A\u043E\u043B\u0435: \u0435\u0449\u0451 +50% \U0001F4D6"
    branch: 1
    knowledgeCost: 15
    requires:
    - mathematics
    - mysticism
  - id: sorcery
    title: "\u0427\u0430\u0440\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u043E"
    description: "\u041B\u0443\u0447\u043D\u0438\u043A \u0438 \u0436\u0440\u0435\u0446
      \u0432 \u043E\u0434\u043D\u043E\u0439 \u043B\u0438\u043D\u0438\u0438 \u043D\u0430
      \u043F\u043E\u043B\u0435 \u2192 \u043C\u0430\u0433: \u0431\u043E\u0435\u0432\u044B\u0435
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u044F \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430
      (\u0446\u0435\u043F\u043D\u0430\u044F \u043C\u043E\u043B\u043D\u0438\u044F)"
    branch: 1
    knowledgeCost: 16
    requires:
    - philosophy
    - staffs
    - archery
  - id: epics
    title: "\u0411\u044B\u043B\u0438\u043D\u044B"
    description: "\u041B\u0438\u043D\u0438\u044F \u0438\u0437 5+ \u043B\u044E\u0431\u044B\u0445
      \u044E\u043D\u0438\u0442\u043E\u0432 \u2192 \u0431\u043E\u0433\u0430\u0442\u044B\u0440\u044C
      (6 \u2014 \u2605\u2605, 7 \u2014 \u2605\u2605\u2605). \u0411\u043E\u0433\u0430\u0442\u044B\u0440\u044C
      \u0432\u0441\u0435\u0433\u0434\u0430 \u043E\u0434\u0438\u043D"
    branch: 1
    knowledgeCost: 26
    requires:
    - sorcery
    - gunpowder
    - martial_arts
  - id: warfare
    title: "\u0412\u043E\u0435\u043D\u043D\u043E\u0435 \u0434\u0435\u043B\u043E"
    description: "\u041A\u0430\u0437\u0430\u0440\u043C\u044B: \u043D\u0430 \u043F\u043E\u043B\u0435
      \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0432\u043E\u0438\u043D\u044B
      (\u043F\u043E\u043A\u0430 \u0431\u0435\u0437 \u0449\u0438\u0442\u043E\u0432)"
    branch: 2
    knowledgeCost: 5
    requires: []
  - id: shields
    title: "\u0429\u0438\u0442\u044B"
    description: "\u041A\u043B\u044E\u0447 \u0431\u043B\u0438\u0436\u043D\u0435\u0433\u043E
      \u0431\u043E\u044F: \u0449\u0438\u0442\u044B \u2014 \u0443\u0434\u0430\u0440
      \u0432 \u043B\u0438\u0446\u043E \u0438\u043D\u043E\u0433\u0434\u0430 \u043B\u043E\u0432\u0438\u0442\u0441\u044F
      \u0446\u0435\u043B\u0438\u043A\u043E\u043C \u0438\u043B\u0438 \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E"
    branch: 2
    knowledgeCost: 7
    requires:
    - warfare
  - id: tower_shields
    title: "\u0420\u043E\u0441\u0442\u043E\u0432\u044B\u0435 \u0449\u0438\u0442\u044B"
    description: "\u041A\u043B\u044E\u0447 II \u044F\u0440\u0443\u0441\u0430 \u0431\u043B\u0438\u0436\u043D\u0435\u0433\u043E
