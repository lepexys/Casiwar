  - type: 19
    title: "\u041C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C"
    shortLabel: "\u041C\u041E\u041D\u0410\u0421\u0422."
    color: {r: 0.86, g: 0.52, b: 0.3, a: 1}
    description: "\u0411\u0435\u0437 \u043D\u0435\u0433\u043E \u043D\u0435\u0442
      \u043C\u043E\u043D\u0430\u0445\u043E\u0432: \u043B\u0438\u043D\u0438\u0438
      \u0432\u043E\u0438\u043D\u043E\u0432 \u0438 \u0436\u0440\u0435\u0446\u043E\u0432
      \u0432 \u043E\u0434\u043D\u043E\u043C \u0441\u043F\u0438\u043D\u0435 \u0432\u0435\u0440\u0431\u043E\u0432\u043A\u0438
      \u0434\u0430\u044E\u0442 \u043C\u043E\u043D\u0430\u0445\u0430, \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u043E\u043A\u0430 \u0441\u0442\u043E\u0438\u0442 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C.
      \u0421\u0442\u0440\u043E\u0438\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E
      \u043D\u0430 \u0433\u043E\u0440\u0435 \u2014 \u0433\u043E\u0440\u044B \u0440\u0435\u0434\u043A\u0438\u0435,
      \u0438\u0449\u0438\u0442\u0435 \u0438\u0445 \u0441\u0440\u0435\u0434\u0438
      \u043A\u0430\u043C\u043D\u0435\u0439 \u0437\u0430 \u0433\u0440\u0430\u043D\u0438\u0446\u0435\u0439
      \u0433\u043E\u0440\u043E\u0434\u0430."
    requiresAnyTech:
    - martial_arts
    productionCost: 15
    maxHp: 70
    unique: 1
    buildable: 1
    unitBranch: 0
    placeOn: 05000000
    effects:
    - effect: 39
      value: 1
      requiredTech: 
      target: 0
    upgrades: []
  - type: 20
    title: "\u0411\u0430\u0448\u043D\u044F \u043C\u0430\u0433\u043E\u0432"
    shortLabel: "\u0411\u0410\u0428\u041D\u042F"
    color: {r: 0.36, g: 0.52, b: 0.92, a: 1}
    description: "\u0411\u0435\u0437 \u043D\u0435\u0451 \u043D\u0435\u0442 \u043C\u0430\u0433\u043E\u0432:
      \u043B\u0438\u043D\u0438\u0438 \u043B\u0443\u0447\u043D\u0438\u043A\u043E\u0432
      \u0438 \u0436\u0440\u0435\u0446\u043E\u0432 \u0432 \u043E\u0434\u043D\u043E\u043C
      \u0441\u043F\u0438\u043D\u0435 \u0432\u0435\u0440\u0431\u043E\u0432\u043A\u0438
      \u0434\u0430\u044E\u0442 \u043C\u0430\u0433\u0430, \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u043E\u043A\u0430 \u0441\u0442\u043E\u0438\u0442 \u0431\u0430\u0448\u043D\u044F.
      \u0421\u0442\u0440\u043E\u0438\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E
      \u043D\u0430 \u0432\u043E\u043B\u0448\u0435\u0431\u043D\u043E\u043C \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0435
      \u2014 \u043E\u043D \u0440\u0435\u0434\u043A\u0438\u0439, \u0431\u044B\u0432\u0430\u0435\u0442
      \u0443 \u0440\u0435\u043A \u0438 \u043E\u0437\u0451\u0440."
    requiresAnyTech:
    - sorcery
    productionCost: 15
    maxHp: 60
    unique: 1
    buildable: 1
