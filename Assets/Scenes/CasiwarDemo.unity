  - id: martial_arts
    title: "\u0411\u043E\u0435\u0432\u044B\u0435 \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0430"
    description: "\u041B\u0438\u043D\u0438\u0438 \u0432\u043E\u0438\u043D\u043E\u0432
      \u0438 \u0436\u0440\u0435\u0446\u043E\u0432 \u0432 \u043E\u0434\u043D\u043E\u043C
      \u0441\u043F\u0438\u043D\u0435 \u0432\u0435\u0440\u0431\u043E\u0432\u043A\u0438
      \u2192 \u043C\u043E\u043D\u0430\u0445: \u0431\u044C\u0451\u0442\u0441\u044F
      \u0432\u0440\u0443\u043A\u043E\u043F\u0430\u0448\u043D\u0443\u044E \u0438 \u0437\u0430\u0436\u0438\u0433\u0430\u0435\u0442
      \u043E\u0440\u0443\u0436\u0438\u0435 \u0441\u0432\u043E\u0438\u0445. \u041D\u0443\u0436\u0435\u043D
      \u0435\u0449\u0451 \u041C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C \u2014
      \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u0433\u043E\u0440\u0435
      (\u0433\u043E\u0440\u044B \u0440\u0435\u0434\u043A\u0438\u0435, \u0441\u0440\u0435\u0434\u0438
      \u043A\u0430\u043C\u043D\u0435\u0439). \u0412\u0435\u0442\u043A\u0430 \u043C\u043E\u043D\u0430\u0445\u043E\u0432
      \u2014 \u0432 \xAB\u0412\u043E\u0439\u0441\u043A\u0430\u0445\xBB \u043F\u043E\u0434
      \u0432\u043E\u0438\u043D\u0430\u043C\u0438 \u0438 \u0436\u0440\u0435\u0446\u0430\u043C\u0438"
    branch: 2
    knowledgeCost: 18
    requires:
    - tower_shields
    - staffs
  - id: bronze
    title: "\u0411\u0440\u043E\u043D\u0437\u0430"
