  - type: 16
    title: "\u041F\u043B\u0430\u0432\u0438\u043B\u044C\u043D\u044F"
    shortLabel: "\u041F\u041B\u0410\u0412\u0418\u041B."
    color: {r: 0.74, g: 0.42, b: 0.26, a: 1}
    description: "+1 \u0441\u043F\u0438\u043D \u0432\u0435\u0440\u0431\u043E\u0432\u043A\u0438
      \u0437\u0430 \u0445\u043E\u0434, \u0433\u0434\u0435 \u043E\u0447\u0435\u043D\u044C
      \u043C\u043D\u043E\u0433\u043E \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u0432
      \u044D\u0442\u043E\u0433\u043E \u043A\u043B\u0430\u0441\u0441\u0430 (\u0431\u043E\u0439\u0446\u044B
      \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F \u0432\u043E\u0438\u043D\u0430\u043C\u0438).
      \u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u043A\u0430\u043C\u043D\u044F\u0445,
      \u043D\u0443\u0436\u043D\u044B \u043A\u0430\u0437\u0430\u0440\u043C\u044B.
      \u0423\u0441\u0438\u043B\u0438\u0442\u0435\u043B\u0435\u0439 (\u043F\u043B\u0430\u0432\u0438\u043B\u044C\u043D\u044F,
      \u043B\u0435\u0441\u043E\u043F\u0438\u043B\u043A\u0430, \u0445\u0440\u0430\u043C)
      \u0432\u0441\u0435\u0433\u043E \u0442\u0440\u0438."
    requiresAnyTech:
    - bronze
    productionCost: 8
    maxHp: 50
    unique: 0
    buildable: 1
    unitBranch: 0
    placeOn: 02000000
    effects:
    - effect: 36
      value: 1
      requiredTech: 
      target: 0
