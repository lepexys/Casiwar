    \u2014 2, \u2605\u2605\u2605 \u2014 3. \u041C\u0435\u0447 \u2014 \u043E\u0440\u0443\u0436\u0438\u0435,
    \u0449\u0438\u0442 \u2014 \u0431\u0440\u043E\u043D\u044F, \u043E\u043D\u0438
    \u043E\u0434\u043D\u0438 \u043D\u0430 \u0432\u0441\u0435\u0445. 3+ \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u0445
    \u043F\u043E\u0434\u0440\u044F\u0434 \u043F\u043E \u043B\u0438\u043D\u0438\u0438
    \u0441 \u043B\u0435\u0432\u043E\u0433\u043E \u0431\u0430\u0440\u0430\u0431\u0430\u043D\u0430:
    3 \u2192 I, 4 \u2192 II, 5 \u2192 III. \u0427\u0435\u0439 \u0442\u0440\u043E\u0444\u0435\u0439
    \u2014 \u0440\u0435\u0448\u0430\u0435\u0442 \u0444\u0438\u0433\u0443\u0440\u0430
    \u043B\u0438\u043D\u0438\u0438:"
